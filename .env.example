# ═══════════════════════════════════════════════════════════
# AI Service Configuration
# ═══════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Change the values marked with ⚠️
# 3. Never commit .env to git (it is in .gitignore)
# ═══════════════════════════════════════════════════════════


# ── Security (CHANGE THESE!) ──────────────────────────────
# ⚠️  Used as the API key for LiteLLM and OpenWebUI
LITELLM_MASTER_KEY=sk-ai-service-2024

# ⚠️  Secret key for OpenWebUI session tokens
WEBUI_SECRET_KEY=change-this-to-a-random-string

# API key for mcpo MCP tool server
MCP_API_KEY=local-tools-key


# ── Model Configuration ────────────────────────────────────
# HuggingFace model ID to use for the main chat LLM
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Short name for the model (used in API calls and LiteLLM config)
CHAT_MODEL_NAME=qwen2.5-7b

# Max context window in tokens (reduce if running out of VRAM)
MAX_MODEL_LEN=4096

# Fraction of GPU VRAM to use (0.0 - 1.0)
# Reduce to 0.75 if you see CUDA out-of-memory errors
GPU_MEMORY_UTILIZATION=0.85


# ── Paths ──────────────────────────────────────────────────
# Where HuggingFace models are cached on the host
MODELS_DIR=${HOME}/ai-models/hf-cache

# Folder that agents can read/write via the filesystem MCP tool
DOCUMENTS_DIR=${HOME}/documents


# ── Qdrant RAG ─────────────────────────────────────────────
# Name of the default Qdrant collection for document search
RAG_COLLECTION=my-knowledge-base


# ── Host ports ─────────────────────────────────────────────
# Published ports on the host. Change any that clash with other
# services already running on your machine (container-internal
# ports are unaffected). Defaults shown; uncomment to override.
# OPENWEBUI_PORT=3000
# MONITOR_PORT=8888
# LITELLM_PORT=4000
# LLM_PORT=8000
# EMBED_PORT=8001
# QDRANT_PORT=6333
# SEARXNG_PORT=8090
# MCPO_PORT=8200
#
# Example: if something else already uses 8090 (SearXNG's default):
# SEARXNG_PORT=8095


# ── SearXNG ────────────────────────────────────────────────
# Change this to any random string for security
SEARXNG_SECRET=searxng-local-secret-change-this


# ── Optional: HuggingFace token ────────────────────────────
# Only needed for gated models (e.g. Llama, Gemma)
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here


# ── vLLM-on-CPU profile (make up-cpu) ──────────────────────
# Used only by docker-compose.cpu.yml — real vLLM engine on CPU.
# On AVX2-only chips (N97/N100) this is slower than make up-n97.
#
# HF model ID (bf16 safetensors, downloaded by make download-cpu)
# CPU_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
#
# Served name — must match model_name in config/litellm-config.cpu.yaml
# CPU_CHAT_MODEL_NAME=qwen2.5-1.5b
#
# Context window (tokens)
# CPU_MAX_MODEL_LEN=2048
#
# GiB of RAM reserved for the KV cache (vLLM default is 4)
# VLLM_CPU_KVCACHE_SPACE=2


# ── N97 / low-power CPU profile (make up-n97) ──────────────
# Used only by docker-compose.n97.yml — see docs/DEPLOY-N97.md
# Uncomment to override the defaults shown here.
#
# Where GGUF model files live on the host
# N97_GGUF_DIR=${HOME}/ai-models/gguf
#
# HF repo + file downloaded by scripts/download-models-n97.sh
# N97_GGUF_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
# N97_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
#
# Served model name — must match model_name in config/litellm-config.n97.yaml
# N97_MODEL_NAME=qwen2.5-3b
#
# Context window (tokens). Larger = more RAM + slower prompt processing.
# N97_CTX=4096
#
# CPU threads for llama.cpp (N97 has 4 cores)
# N97_THREADS=4
