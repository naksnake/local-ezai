# ═══════════════════════════════════════════════════════════
# AI Service Configuration
# ═══════════════════════════════════════════════════════════
# 1. Copy this file:  cp .env.example .env
# 2. Change the values marked with ⚠️
# 3. Never commit .env to git (it is in .gitignore)
# ═══════════════════════════════════════════════════════════


# ── Security (CHANGE THESE!) ──────────────────────────────
# ⚠️  Used as the API key for LiteLLM and OpenWebUI
LITELLM_MASTER_KEY=sk-ai-service-2024

# ⚠️  Secret key for OpenWebUI session tokens
WEBUI_SECRET_KEY=change-this-to-a-random-string

# API key for mcpo MCP tool server (also the monitor's machine credential)
MCP_API_KEY=local-tools-key

# ── Monitor RBAC ───────────────────────────────────────────
# The dashboard at :8888 asks for a login. Two browser roles:
#   admin  — full access (RAG upload / remove)
#   viewer — read-only dashboard
# ⚠️  Change both passwords. MONITOR_AUTH=false disables the login.
MONITOR_ADMIN_PASSWORD=admin
MONITOR_VIEWER_PASSWORD=viewer
# MONITOR_AUTH=true

# ── Web search in chat ─────────────────────────────────────
# Chat messages can search the web through the bundled private SearXNG
# (toggle the globe icon in OpenWebUI's message box). No cloud API used.
# ENABLE_WEB_SEARCH=true


# ── Model Configuration ────────────────────────────────────
# vLLM image for the GPU profile. Override for other architectures, e.g.
# an arm64/Grace-Blackwell build or an NGC image on GB300-class machines.
# VLLM_IMAGE=vllm/vllm-openai:latest

# Embedding model for RAG (served by embed-server, all profiles).
# For multilingual documents use e.g. BAAI/bge-m3 — then re-embed into a
# fresh collection (vector size changes). See README "Multi-language".
# CPU_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# HuggingFace model ID to use for the main chat LLM
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Short name for the model (used in API calls and LiteLLM config)
CHAT_MODEL_NAME=qwen2.5-7b

# Max context window in tokens (reduce if running out of VRAM)
MAX_MODEL_LEN=4096

# Fraction of GPU VRAM to use (0.0 - 1.0)
# Reduce to 0.75 if you see CUDA out-of-memory errors
GPU_MEMORY_UTILIZATION=0.85


# ── Paths ──────────────────────────────────────────────────
# Everything lives inside the project folder by default — models in
# ./models, shared documents in ./documents. Uncomment to relocate
# (prefer ABSOLUTE paths; ~ and ${HOME} differ between root and normal
# users, which mounts an empty folder and crashes vLLM/embed-server).
# MODELS_DIR=/absolute/path/to/hf-cache

# Folder that agents can read/write via the filesystem MCP tool
# DOCUMENTS_DIR=/absolute/path/to/documents


# ── Qdrant RAG ─────────────────────────────────────────────
# Name of the default Qdrant collection for document search
RAG_COLLECTION=my-knowledge-base


# ── LAN address ────────────────────────────────────────────
# IP (or hostname) of this machine on your network. Used in the tool-server
# URLs that OpenWebUI's browser side fetches directly — REQUIRED if you open
# the UI from other devices; 'localhost' only works on the box itself.
# LAN_HOST=192.168.100.1


# ── Host ports ─────────────────────────────────────────────
# Published ports on the host. Change any that clash with other
# services already running on your machine (container-internal
# ports are unaffected). Defaults shown; uncomment to override.
# OPENWEBUI_PORT=3000
# MONITOR_PORT=8888
# LITELLM_PORT=4000
# LLM_PORT=8000
# EMBED_PORT=8001
# QDRANT_PORT=6333
# SEARXNG_PORT=8092
# MCPO_PORT=8200
#
# Example: if something else already uses 8092 (SearXNG's default):
# SEARXNG_PORT=8095


# ── SearXNG ────────────────────────────────────────────────
# Change this to any random string for security
SEARXNG_SECRET=searxng-local-secret-change-this


# ── Optional: HuggingFace token ────────────────────────────
# Only needed for gated models (e.g. Llama, Gemma)
# Get your token at: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_your_token_here


# ── vLLM-on-CPU profile (make up-cpu) ──────────────────────
# Used only by docker-compose.cpu.yml — real vLLM engine on CPU.
# On AVX2-only chips (N97/N100) this is slower than make up-n97.
#
# HF model ID (bf16 safetensors, downloaded by make download-cpu)
# CPU_CHAT_MODEL=Qwen/Qwen2.5-1.5B-Instruct
#
# Served name — must match model_name in config/litellm-config.cpu.yaml
# CPU_CHAT_MODEL_NAME=qwen2.5-1.5b
#
# Context window (tokens)
# CPU_MAX_MODEL_LEN=2048
#
# GiB of RAM reserved for the KV cache (vLLM default is 4)
# VLLM_CPU_KVCACHE_SPACE=2


# ── N97 / low-power CPU profile (make up-n97) ──────────────
# Used only by docker-compose.n97.yml — see docs/DEPLOY-N97.md
# Uncomment to override the defaults shown here.
#
# Where GGUF model files live on the host
# N97_GGUF_DIR=/absolute/path/to/gguf   # default: ./models/gguf
#
# HF repo + file downloaded by scripts/download-models-n97.sh.
# Default: Qwen2.5-1.5B chat model (Apache-2.0, fast). Alternatives —
# uncomment ONE block, then: make download-n97 && docker compose \
#   -f docker-compose.yml -f docker-compose.n97.yml up -d vllm
#
# Coder 1.5B — code generation / explanation specialist (Apache-2.0):
# N97_GGUF_REPO=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF
# N97_MODEL_FILE=qwen2.5-coder-1.5b-instruct-q4_k_m.gguf
# N97_MODEL_NAME=qwen2.5-coder-1.5b
#
# 3B chat — better quality, ~half speed (Qwen Research License, NON-commercial):
# N97_GGUF_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
# N97_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# N97_MODEL_NAME=qwen2.5-3b
#
# All three names above are pre-routed in config/litellm-config.n97.yaml.
#
# Context window (tokens). Larger = more RAM + slower prompt processing.
# Default 8192: tool schemas + chat history overflow 4096 in normal use.
# Raise to 16384 if you hit ContextWindowExceededError (long chats, web
# search on) — costs ~0.3 GB (1.5B) / ~0.6 GB (3B) extra RAM, and big
# prompts take noticeably longer to process on low-power CPUs.
# N97_CTX=8192
#
# CPU threads for llama.cpp (N97 has 4 cores)
# N97_THREADS=4
