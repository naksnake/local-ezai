# ── Environment & Secrets ─────────────────────────────────────────────────
.env
*.key
*.pem
*.crt

# ── AI Models (too large for git — stored in ./models) ────────────────────
# Anchored to the checkout root: the weights live in ./models, while
# config/models/ is the registry + generations (declarative state, meant to
# be committed — ADR-025).
*.bin
*.safetensors
*.gguf
*.pt
*.onnx
/models/
ai-models/
hf-cache/

# ── User content (documents embedded into the knowledge base) ─────────────
documents/

# ── Docker volumes & runtime data ─────────────────────────────────────────
data/
volumes/
*.db

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
.env/
ai-env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node.js ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm

# ── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.directory

# ── Editor ────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.vim/

# ── Kubernetes ────────────────────────────────────────────────────────────
kubeconfig
.kube/

# ── Temporary ─────────────────────────────────────────────────────────────
tmp/
temp/
.tmp/
*.tmp

# ── agentd (autonomous SWE runtime) ───────────────────────────────────────
.venv-agentd/
.agentd/

# ── first run (local-ezai setup): the report + WebUI banner, the sample
#    project working copy at the checkout root (the source that IS tracked
#    lives in examples/sample-project — hence the leading slash)
config/first-run/
config/soak/
/sample-project/

# ── machine-managed platform state: the daemon's idempotency + run records
#    (response bodies included) and the artifacts re-rendered from the
#    registry (the manifest refuses drift). config/governance/ (queue, audit
#    log) is operator state the maintenance guide backs up — never ignore it.
config/control/
config/rendered/
